<!doctype html>
<html>
<head>
  <title>Player Support | Keizaal Online</title>
  <%- include('partials/head-tags') %>
</head>
<body>
  <div class="player-page">
    <%- include('partials/player-nav', { active: 'home' }) %>

    <div class="hero">
      <div class="eyebrow">Player Support</div>
      <h1>How can we help?</h1>
      <p>Report a player, get help with your account, or apply to join the Keizaal Online team. Pick an option below to open a ticket.</p>
    </div>

    <div class="section" id="support">
      <div class="section-title">Open a Ticket</div>
      <div class="section-hint">General Tickets, Player Reports, and Item Restoration are handled per realm. Pick yours to begin.</div>
      <div class="grid">
        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 0 1 4.8 1c0 1.7-2.3 1.7-2.3 3.5"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg></div>
            <div class="card-title">General Tickets</div>
          </div>
          <div class="card-desc">Tech help, whitelisting, and anything not covered by another category.</div>
          <div class="chip-row">
            <a class="chip" href="/support/new?type=general&realm=Sovngarde">Sovngarde</a>
            <a class="chip" href="/support/new?type=general&realm=Paarthurnax">Paarthurnax</a>
            <a class="chip" href="/support/new?type=general&realm=Moonshadow">Moonshadow</a>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v18"/><path d="M6 4h11l-2.5 3.5L17 11H6"/></svg></div>
            <div class="card-title">Player Report</div>
          </div>
          <div class="card-desc">Report rule-breaking, metagaming, or misconduct by another player.</div>
          <div class="chip-row">
            <a class="chip" href="/support/new?type=player_report&realm=Sovngarde">Sovngarde</a>
            <a class="chip" href="/support/new?type=player_report&realm=Paarthurnax">Paarthurnax</a>
            <a class="chip" href="/support/new?type=player_report&realm=Moonshadow">Moonshadow</a>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 1 2.6 5.9"/><path d="M4 21v-5h5"/></svg></div>
            <div class="card-title">Item Restoration</div>
          </div>
          <div class="card-desc">Lost items or gear to a bug or crash? Request a restoration.</div>
          <div class="chip-row">
            <a class="chip" href="/support/new?type=item_restoration&realm=Sovngarde">Sovngarde</a>
            <a class="chip" href="/support/new?type=item_restoration&realm=Paarthurnax">Paarthurnax</a>
            <a class="chip" href="/support/new?type=item_restoration&realm=Moonshadow">Moonshadow</a>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6.5v5c0 5 3.4 8.4 8 9.5 4.6-1.1 8-4.5 8-9.5v-5L12 3Z"/><path d="M12 9v4M12 15.3h.01"/></svg></div>
            <div class="card-title">Staff Report</div>
          </div>
          <div class="card-desc">Raise a concern about a staff member. Seen only by Lead Gamemasters and above.</div>
          <div class="chip-row"><a class="chip chip-wide" href="/support/new?type=staff_report">Open Ticket</a></div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="10" height="12" rx="4"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7M4 12h3M17 12h3M6.5 8.5 5 7M17.5 8.5 19 7M6.5 15.5 5 17M17.5 15.5 19 17"/></svg></div>
            <div class="card-title">Bug Report</div>
          </div>
          <div class="card-desc">Found something broken? Let us know what happened and how to reproduce it.</div>
          <div class="chip-row"><a class="chip chip-wide" href="/support/new?type=bug_report">Open Ticket</a></div>
        </div>
      </div>
    </div>

    <div class="section" id="applications">
      <div class="section-title">Applications</div>
      <div class="section-hint">Support and GM applications require 30 days in the community. Modder applications require 60 days.</div>
      <div class="grid">
        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 0 1 4.8 1c0 1.7-2.3 1.7-2.3 3.5"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg></div>
            <div class="card-title">Support Application</div>
          </div>
          <div class="card-desc">Apply to become a Gamemaster and help run Keizaal Online.</div>
          <div class="chip-row"><a class="chip chip-wide" href="/support/new?type=support_application">Apply</a></div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l2.6-2.6a5 5 0 0 1-6.6 6.6L7 21l-2-2 8.3-8.3a5 5 0 0 1 6.6-6.6Z"/></svg></div>
            <div class="card-title">Modder Application</div>
          </div>
          <div class="card-desc">Join the build and modding team creating new content across the realms.</div>
          <div class="chip-row"><a class="chip chip-wide" href="/support/new?type=modder_application">Apply</a></div>
        </div>

        <div class="card">
          <div class="card-head">
            <div class="card-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10.5 21 8v8l-5-2.5"/></svg></div>
            <div class="card-title">Media Application</div>
          </div>
          <div class="card-desc">Create clips, screenshots, or highlights for the community.</div>
          <div class="chip-row"><a class="chip chip-wide" href="/support/new?type=media_application">Apply</a></div>
        </div>
      </div>
    </div>

    <div class="pfoot">
      <span>&copy; Keizaal Online</span>
      <span>Not staff? Player reports are the fastest way to reach us.</span>
    </div>
  </div>
</body>
</html>
