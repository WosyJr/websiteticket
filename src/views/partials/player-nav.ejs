<div class="pnav">
  <a class="brand" href="/" style="display:flex;align-items:center;gap:10px;">
    <span class="brand-word">KEIZAAL ONLINE</span>
  </a>
  <div class="pnav-links">
    <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Home</a>
    <a href="/#support" class="<%= active === 'support' ? 'active' : '' %>">Support</a>
    <a href="https://discord.gg/" target="_blank" rel="noopener">Discord</a>
  </div>
  <div class="pnav-spacer"></div>
  <% if (user) { %>
    <a class="btn btn-outline" href="/my-tickets">My Tickets</a>
    <% if (user.is_staff) { %>
      <a class="btn btn-primary" href="/staff">Staff Portal</a>
    <% } %>
    <form method="post" action="/auth/logout" style="margin:0;">
      <button class="btn btn-outline" type="submit"><%= user.username %> &middot; Sign out</button>
    </form>
  <% } else { %>
    <a class="btn btn-outline" href="/player-login">My Tickets</a>
    <a class="btn btn-blurple" href="/auth/discord/login?from=player">Sign in with Discord</a>
  <% } %>
</div>
