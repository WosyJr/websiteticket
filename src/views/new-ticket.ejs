<!doctype html>
<html>
<head>
  <title>New Ticket | Keizaal Online</title>
  <%- include('partials/head-tags') %>
</head>
<body>
  <div class="player-page">
    <%- include('partials/player-nav', { active: 'support', user: user }) %>

    <div class="form-wrap">
      <div class="crumb" style="margin-bottom:20px;"><a href="/">Home</a> / <a href="/#support">Support</a> / New Ticket</div>

      <% if (!user) { %>
        <div class="flash-error">You'll need to <a href="/auth/discord/login?from=player">sign in with Discord</a> before you can submit this, but you can still fill it out first.</div>
      <% } %>

      <div class="form-card">
        <div class="form-card-head">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v18"/><path d="M6 4h11l-2.5 3.5L17 11H6"/></svg>
          <div class="form-card-title">
            Support Ticket
            <span style="color:var(--text-faint);font-weight:600;">
              | <%= ({player_report:'Player Report', item_restoration:'Item Restoration', general:'General Tickets', staff_report:'Staff Report', bug_report:'Bug Report', support_application:'Support Application', modder_application:'Modder Application', media_application:'Media Application'})[type] %>
            </span>
          </div>
        </div>

        <form method="post" action="/api/tickets" style="padding:0 22px 20px;display:flex;flex-direction:column;gap:20px;">
          <input type="hidden" name="type" value="<%= type %>">

          <% if (['general','player_report','item_restoration'].includes(type)) { %>
            <div class="field">
              <label>Realm</label>
              <select name="realm" id="realmSelect">
                <% realms.forEach(function(r){ %>
                  <option value="<%= r %>" <%= r === realm ? 'selected' : '' %>><%= r %></option>
                <% }) %>
              </select>
            </div>

            <div class="field">
              <label>Your Character</label>
              <% if (user) { %>
                <select name="character_choice" id="characterChoice">
                  <option value="">No character selected</option>
                  <option value="__new__">+ Add a new character</option>
                </select>
                <input type="text" name="new_character_name" id="newCharacterName" placeholder="Character name" style="margin-top:8px;" hidden>
                <div class="hint">Showing characters for the selected realm. Manage all your characters anytime from <a href="/my-characters">My Characters</a>.</div>
              <% } else { %>
                <input type="text" disabled placeholder="Sign in to select your character">
              <% } %>
            </div>
          <% } %>

          <% questions.forEach(function(q, i){ %>
            <div class="field">
              <label><%= q %></label>
              <% if (q.toLowerCase().includes('what happened') || q.toLowerCase().includes('rules were broken') || q.toLowerCase().includes('how can we help') || q.toLowerCase().includes('need restored') || q.toLowerCase().includes('reproduce') || q.toLowerCase().includes('anything else') || q.toLowerCase().includes('want to become') || q.toLowerCase().includes('prior staff') || q.toLowerCase().includes('scripting, or level-design') || q.toLowerCase().includes('portfolio') || q.toLowerCase().includes('like to work on') || q.toLowerCase().includes('link examples')) { %>
                <textarea name="answers" required></textarea>
              <% } else { %>
                <input type="text" name="answers" required>
              <% } %>
            </div>
          <% }) %>

          <div class="submit-row">
            <button class="btn btn-submit" type="submit">Submit Ticket</button>
            <span class="submit-note">Misuse of the report system may result in action against your account.</span>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var myCharacters = <%- JSON.stringify(typeof myCharacters !== 'undefined' ? myCharacters : []) %>;
    var realmSelect = document.getElementById('realmSelect');
    var characterChoice = document.getElementById('characterChoice');
    var newCharacterName = document.getElementById('newCharacterName');
    if (!characterChoice) return;

    function renderOptions() {
      var realm = realmSelect ? realmSelect.value : null;
      var matches = myCharacters.filter(function (c) { return c.realm === realm; });
      characterChoice.innerHTML = '';
      var none = document.createElement('option');
      none.value = '';
      none.textContent = 'No character selected';
      characterChoice.appendChild(none);
      matches.forEach(function (c) {
        var opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.character_name;
        characterChoice.appendChild(opt);
      });
      var addNew = document.createElement('option');
      addNew.value = '__new__';
      addNew.textContent = '+ Add a new character';
      characterChoice.appendChild(addNew);
      newCharacterName.hidden = true;
      newCharacterName.value = '';
    }

    characterChoice.addEventListener('change', function () {
      newCharacterName.hidden = characterChoice.value !== '__new__';
    });
    if (realmSelect) realmSelect.addEventListener('change', renderOptions);
    renderOptions();
  })();
  </script>
</body>
</html>
