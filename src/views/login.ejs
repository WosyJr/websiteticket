<!doctype html>
<html>
<head>
  <title>Sign in | Keizaal Online Staff Portal</title>
  <%- include('partials/head-tags') %>
</head>
<body>
  <div class="login-wrap">
    <div class="login-brand">
      <h1 class="login-wordmark">Staff<br>Portal</h1>
      <p class="login-tagline">Support tickets, player reports, and moderation tools for the Keizaal Online team, synced with Discord.</p>
    </div>
    <div class="login-panel">
      <div class="login-card">
        <div class="eyebrow">Staff Portal</div>
        <h1>Welcome back</h1>
        <p>Sign in with your Discord account to access tickets, player reports, and moderation tools.</p>
        <% if (error) { %>
          <div class="flash-error">
            <% if (error === 'discord_failed') { %>Discord sign-in failed. Try again, or check the server logs.
            <% } else { %>Sign-in error: <%= error %><% } %>
          </div>
        <% } %>
        <a class="btn btn-blurple" href="/auth/discord/login?from=staff" style="height:52px;font-size:15px;">
          Continue with Discord
        </a>
        <div style="font-size:12px;color:var(--text-faint);line-height:1.6;">Access is granted automatically based on your staff role in the Keizaal Online Discord.</div>
        <% if (devLogin) { %>
          <div class="dev-login-box">
            <b>Dev mode:</b> Discord isn't configured yet (or you just want to test).
            <a class="btn btn-outline" href="/auth/dev-login">Use dev login instead</a>
          </div>
        <% } %>
        <div style="font-size:13px;color:var(--text-faint);text-align:center;border-top:1px solid var(--border);padding-top:16px;">
          Not staff? Visit the <a href="/player-login">player sign-in</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
